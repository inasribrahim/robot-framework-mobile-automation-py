<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<!--
  TestNG suite configuration.

  Single-thread execution (safe for one emulator / device).
  To enable parallel scenario execution set parallel="methods" and update
  TestRunner.scenarios() DataProvider to parallel = true.
-->
<suite name="Android Automation Suite" verbose="1" parallel="false">

  <listeners>
    <!-- Plugs Allure into the TestNG lifecycle -->
    <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
  </listeners>

  <test name="Android Mobile Tests">
    <classes>
      <class name="com.automation.runners.TestRunner"/>
    </classes>
  </test>

</suite>
